{
  "id": "ui-asset-loading",
  "version": "1.0.0",
  "title": "UI + Async Asset Loading",
  "category": "ui",
  "status": "stable",
  "specStatus": "frozen",
  "requiresDevTools": false,
  "learning": {
    "goal": "掌握 UI 控件驱动的异步资源加载全链路：成功/404 失败/重试/并发锁/销毁守卫/释放与重建（G1/P08）",
    "points": [
      "loadAssetAsync 三形态：注册表 (path,type) 命中同一实例、URL JSON 回退、注册表未命中的拒绝路径（消息可读）",
      "状态锁防快速重复点击：并发 3 个 requestLoad 只有 1 个真正启动（loadStarts/lockRejects 计数自证）",
      "销毁守卫：加载回调落地时 isValid(node) 拦截，悬空效果计数恒 0；Node.on/off 对称订阅退订",
      "释放链：assets.remove → releaseAsset → destroy，重建走与首次完全相同的实现路径（__lifecycle 合同）"
    ]
  },
  "effect": {
    "functional": "确定性时间线：P1 注册表往返（loadAssetAsync('gen/panel',Texture2D) 命中 add 的同一实例并上屏）；P2 URL JSON 加载（assets/panel-manifest.json，name/items 字段核对）；P3 加载不存在 URL → 拒绝且消息含 404，UI 进入 failed 态；P4 同 URL 重试如实再败 → 注册表回退成功恢复 loaded；P5 三个并发 requestLoad 仅 1 启动 2 拒绝；P6 临时组件发起失败加载后立即销毁，回调被 isValid 守卫拦截（danglingEffects=0, guardedCallbacks=1）。交互点击 LoadButton → clicks+1 并触发带锁重载。__lifecycle()：release=注册表移除+releaseAsset+destroy（持有引用 invalid），reacquire=同路径重建（画面复原）。所有失败路径均为故意拒绝且被 try/catch 捕获——不产生 window error/unhandledrejection，也不产生 HTTP 错误；任一 pcheck 失败 → throw → no-runtime-error 红。",
    "visual": "深蓝 UI 背景；中央蓝色 LoadButton（按下变橙）；上方 Preview 精灵从灰色占位变为绿色纹理；顶部状态行显示 phase/state，底部信息行显示 loads/locks/clicks/fails 实时计数"
  },
