  "learning": {
    "goal": "tween() 补间链：.to 多段 + 缓动 + onComplete 循环续接",
    "points": [
      "tween(target) 工厂与链式 .to",
      "easing: \"sineInOut\" 缓动",
      "onComplete 自续接形成往返循环"
    ]
  },
  "effect": {
    "functional": "tween-cube 的 position 由补间驱动在 x=-3 与 x=3 之间往返（sineInOut），onComplete 续接实现持续运动；非 setInterval 覆盖。",
    "visual": "立方体在左右两端之间平滑往返，两端缓入缓出"
  },
