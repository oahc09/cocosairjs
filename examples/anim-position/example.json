  "learning": {
    "goal": "掌握程序化动画的最小骨架：Component.update(dt) 中推进时间并改写位置",
    "points": [
      "update 的 dt 增量语义（与帧率无关的推进）",
      "Math.sin 生成往复轨迹",
      "setPosition 每帧覆盖位置"
    ]
  },
  "effect": {
    "functional": "Mover 的 X 坐标按 sin(t*2)*2.2 持续变化；动画相位由 dt 累加驱动；position(t1) != position(t0)。",
    "visual": "蓝色方块在画面中左右匀速往复滑动，路径为水平直线"
  },
