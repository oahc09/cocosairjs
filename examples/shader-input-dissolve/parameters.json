{
  "name": "inputDissolve",
  "version": "1.0.0",
  "description": "NoiseDissolve over arbitrary input: image / procedural / rendered layer routes",
  "schema": "shaders-effect-contract/1",
  "params": {
    "route": {
      "type": "enum",
      "values": ["image", "procedural", "rendered"],
      "default": "image",
      "description": "Input route"
    },
    "progress": {
      "type": "number",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Dissolve progress (0 identity, 1 fully transparent)"
    },
    "scale": {
      "type": "number",
      "default": 3,
      "min": 0.5,
      "max": 20,
      "step": 0.1,
      "description": "Noise frequency"
    },
    "softness": {
      "type": "number",
      "default": 0.25,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Edge feather"
    },
    "seed": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "description": "Pattern seed"
    },
    "invert": {
      "type": "enum",
      "values": ["off", "on"],
      "default": "off",
      "description": "Reverse dissolve order"
    },
    "dissolveEnabled": {
      "type": "enum",
      "values": ["on", "off"],
      "default": "on",
      "description": "Layer enable (off = true input-copy pass)"
    },
    "time": {
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 3600,
      "step": 0.01,
      "description": "Presentation clock (read-only)"
    }
  }
}
