    "steps": [
      {
        "action": "点击 重置",
        "buttonText": "重置",
        "expected": "时间与参数回到初始值，画面跳变到初始帧"
      },
      {
        "action": "执行示例 linearProbe 读回探针",
        "probe": "__inputdissolve.linearProbe",
        "expected": "真实渲染进 RT 并读回固定采样点，createAirRenderTarget 实际执行"
      },
      {
        "action": "真实参数更新 progress（完全溶解）",
        "probe": "__inputdissolve.set",
        "probeArgs": [
          {
            "route": "image",
            "progress": 0.9,
            "scale": 3,
            "softness": 0.25,
            "seed": 0,
            "invert": "off",
            "dissolveEnabled": "on",
            "time": 0
          }
        ],
        "expected": "公开参数合同真实更新 uniform，溶解进度可见变化"
      },
      {
        "action": "单步推进示例步进时钟",
        "probe": "__inputdissolve.step",
        "probeArgs": [0.0333],
        "expected": "真实 game.pause + createStepClock 后确定帧推进，时间轴画面变化"
      },
      {
        "action": "恢复原生 pacer",
        "probe": "__inputdissolve.resumePacer",
        "expected": "结束步进时钟并恢复原生 pacer，后续帧继续真实渲染"
      }
    ]
