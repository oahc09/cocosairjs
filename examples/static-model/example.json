  "learning": {
    "goal": "Runtime 资产链路：程序化 Mesh 入库 → loadAssetAsync 取回 → 贴图材质渲染（E007 gltf-basic 的资产形态）",
    "points": [
      "assetManager.assets 注册与 loadAssetAsync Promise 加载",
      "ImageAsset/Texture2D 程序化贴图",
      "USE_ALBEDO_MAP define + mainTexture 接线"
    ]
  },
  "effect": {
    "functional": "checkerboard 源 Mesh 经 assetManager.assets.add 注册后由 loadAssetAsync 取回同一实例（console.assert 相等）；StaticBox 材质带 USE_ALBEDO_MAP 与 mainTexture；frameObject 取景。",
    "visual": "棋盘格贴图的金字塔/方块置于绿色地面上，纹理随视角变化清晰可辨"
  },
