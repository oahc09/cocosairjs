  "learning": {
    "goal": "区分 builtin-standard（受光照）与 builtin-unlit（纯平色）两种效果，理解 unlit 的适用场景",
    "points": [
      "builtinResMgr.get 获取内建材质",
      "unlit 材质忽略灯光，颜色恒定",
      "旋转时标准面明暗变化而 unlit 面恒定"
    ]
  },
  "effect": {
    "functional": "LitCube 使用 builtin-standard-material，UnlitCube 使用 builtin-unlit-material；两者同尺寸同步旋转。",
    "visual": "左立方体表面有明暗过渡（受平行光），右立方体每个面都是均匀纯蓝色，无任何明暗变化"
  },
