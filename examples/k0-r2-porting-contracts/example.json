  "requiresDevTools": false,
  "learning": {
    "goal": "用原生网格和材质 API 比较顶点色、混合、局部更新与 Billboard 尺寸",
    "points": [
      "顶点色同时需要颜色属性和 USE_VERTEX_COLOR",
      "透明和加色由 blendState 与 depthWrite 定义",
      "动态局部更新保留索引并通知渲染器",
      "Billboard 用 width/height 定义尺寸；所有模式归还自有引用"
    ]
  },
  "effect": {
    "functional": "四个真实按钮切换模式；暂停冻结动态网格，恢复继续更新；重置重建，释放解绑并归还自有资源。",
    "visual": "顶点色是红绿蓝黄渐变四边形；混合模式在绿底上显示黄色透明区和青色加色区；动态青色网格边缘摆动；Billboard 显示四色纹理。"
  },
