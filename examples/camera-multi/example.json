{
  "id": "camera-multi",
  "version": "1.0.0",
  "title": "Multi Camera",
  "category": "camera",
  "status": "stable",
  "specStatus": "frozen",
  "requiresDevTools": false,
  "learning": {
    "goal": "掌握多相机：viewport 矩形切分屏幕、priority 控制渲染顺序",
    "points": [
      "用 camera.visibility + Layers 控制每台相机的可见层级",
      "用 priority 决定相机渲染次序",
      "用 ClearFlag.DEPTH_ONLY 保留颜色缓冲叠加渲染"
    ]
  },
  "effect": {
    "functional": "BaseCamera（priority 0）只渲染 DEFAULT 层（Floor+BlueSphere，SOLID_COLOR 清屏）；OverlayCamera（priority 1）只渲染 UI_2D 层的 OrangeSphere，clearFlags=DEPTH_ONLY 保留底层颜色实现叠加。",
    "visual": "地面与蓝球由基础相机呈现，橙球由叠加相机画在同一画面上（两层内容同屏可见，且橙球位置正确遮挡/被遮挡于空间中）"
  },
