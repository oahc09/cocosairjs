  "learning": {
    "goal": "掌握 glTF 扩展注册面：loader 级 register/unregister、解码器/转码器挂接入口、注册表三件套（注册/注销/建 handler/必选校验）。",
    "points": [
      "register/unregister 成对往返",
      "setDRACODecoder(null) 表示清除（try 兜底）",
      "validateRequired 空输入安全"
    ]
  },
  "effect": {
    "functional": "脚手架（Main Camera/Main Light/Cube）+ 主题 API 的确定性 readback：window.__probe() 返回的每个字段在同一构建下取值唯一，跨引擎逐位相等；__airApp 在场景启动后出现。",
    "visual": "深蓝底（clearColor 28,36,52）三件套场景：居中立方体（颜色 200,230,210）、方向光、透视相机。"
  },
