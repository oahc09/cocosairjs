{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2015", "es2017", "dom"],
    "module": "commonjs",
    "sourceMap": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
        "pal/*": [
            "pal/*"
        ],
        "cc.decorator": [
            "cocos/core/data/decorators/index.ts"
        ],
        "@cocos/engine/*": [
            "*"
        ]
    },
    "types": [
      "jest",
      "./src/@types/globals",
      "./src/@types/consts",
      "./src/@types/jsb",
      "./src/@types/editor-extends",
      "./src/@types/webGL.extras",
      "./src/@types/webGL2.extras",

      // pal
      "./src/@types/pal/system-info",
      "./src/@types/pal/screen-adapter",
      "./src/@types/pal/minigame",
      "./src/@types/pal/audio",
      "./src/@types/pal/input",
      "./src/@types/pal/env",
      "./src/@types/pal/pacer",
      "./src/@types/pal/wasm"
    ]
  },
  "include": [
      "src/**/*.ts",
      "src/**/*.d.ts"
  ],
  "exclude": [
      "src/editor"
  ]
}
