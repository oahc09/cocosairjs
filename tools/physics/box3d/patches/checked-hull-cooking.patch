+/* AIR reviewed additive checked cooker. Not a change to legacy hull reduction.
+   Workspace is supplied/owned by the caller. Final hull still uses b3Alloc,
+   whose failure is not a recoverable allocation status. */
+typedef enum b3HullCookStatus
+{
+    b3_hullCookSuccess = 0,
+    b3_hullCookArgument,
+    b3_hullCookCapacity,
+    b3_hullCookDegenerate,
+    b3_hullCookTopology,
+    b3_hullCookIncomplete,
+    b3_hullCookNumeric
+} b3HullCookStatus;
+typedef struct b3HullCookInfo
+{
+    b3HullCookStatus status;
+    float tolerance;
+    float minOutside;
+    float maximumSeparation;
+    int firstOutsidePoint;
+    int budgetExhausted;
+} b3HullCookInfo;
+/* Exact private-layout bytes; false leaves outBytes unchanged. */
+B3_API bool b3GetHullWorkspaceSize( int pointCount, int maxVertexCount, size_t* outBytes );
+B3_API b3HullData* b3CreateHullChecked( const b3Vec3* points, int pointCount, int maxVertexCount,
+                                     void* workspace, size_t workspaceBytes, b3HullCookInfo* info );
