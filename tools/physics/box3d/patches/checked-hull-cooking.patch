+b3HullData* b3CreateHullChecked( const b3Vec3* points, int pointCount, int maxVertexCount,
+                               void* workspace, size_t workspaceBytes, b3HullCookInfo* info )
+{
+    if ( info == NULL ) return NULL;
+    *info = (b3HullCookInfo){ .status = b3_hullCookArgument, .firstOutsidePoint = -1 };
+    if ( points == NULL || workspace == NULL || (uintptr_t)workspace % 8 || pointCount < 4 ||
+         maxVertexCount < 4 || maxVertexCount > B3_MAX_HULL_VERTICES ) return NULL;
+    size_t required;
+    if ( !b3GetHullWorkspaceSize( pointCount, maxVertexCount, &required ) || workspaceBytes < required )
+    {
+        info->status = b3_hullCookCapacity;
+        return NULL;
+    }
+    for ( int i = 0; i < pointCount; ++i )
+    {
+        if ( !b3IsValidVec3( points[i] ) ) return NULL;
+    }
+    info->status = b3_hullCookDegenerate;
+    return b3CreateHullInternal( points, pointCount, maxVertexCount, workspace, workspaceBytes, info );
 }
 
