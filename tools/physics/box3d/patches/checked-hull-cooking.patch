+/* The same scalar plane separation and strict > minOutside boundary used
+   by conflict assignment, evaluated before origin restoration loses precision.
+   This does not infer final topology from the point-addition budget. */
+static bool b3HullBuilder_CheckAllPoints( const b3HullBuilder* b, const b3Vec3* shiftedPoints,
+                                        int pointCount, b3HullCookInfo* info )
+{
+    info->tolerance = b->tolerance;
+    info->minOutside = b->minOutside;
+    info->maximumSeparation = -FLT_MAX;
+    info->firstOutsidePoint = -1;
+    for ( b3QHListNode* node = b->faceList.link.next; node != &b->faceList.link; node = node->next )
+    {
+        const b3QHFace* face = (const b3QHFace*)node;
+        if ( !isfinite( face->plane.normal.x ) || !isfinite( face->plane.normal.y ) ||
+             !isfinite( face->plane.normal.z ) || !isfinite( face->plane.offset ) )
+        {
+            info->status = b3_hullCookNumeric;
+            return false;
+        }
+        for ( int i = 0; i < pointCount; ++i )
+        {
+            float separation = b3PlaneSeparation( face->plane, shiftedPoints[i] );
+            if ( !isfinite( separation ) )
+            {
+                info->status = b3_hullCookNumeric;
+                return false;
+            }
+            info->maximumSeparation = b3MaxFloat( info->maximumSeparation, separation );
+            if ( separation > b->minOutside && info->firstOutsidePoint < 0 ) info->firstOutsidePoint = i;
+        }
+    }
+    if ( info->firstOutsidePoint >= 0 )
+    {
+        info->status = b3_hullCookIncomplete;
+        return false;
+    }
+    return true;
+}
