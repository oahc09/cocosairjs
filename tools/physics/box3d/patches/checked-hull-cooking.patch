+static bool b3HullWorkAppend( size_t* offset, size_t count, size_t itemSize, bool align )
+{
+    if ( count > ( SIZE_MAX - *offset ) / itemSize ) return false;
+    size_t next = *offset + count * itemSize;
+    if ( align )
+    {
+        if ( next > SIZE_MAX - 7 ) return false;
+        next = ( next + 7 ) & ~(size_t)7;
