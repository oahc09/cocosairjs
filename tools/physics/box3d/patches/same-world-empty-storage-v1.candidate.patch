+static bool b3HasRetainedEvents( const b3World* world )
+{
+	return world->bodyMoveEvents.count != 0 || world->sensorBeginEvents.count != 0 ||
+		world->sensorEndEvents[0].count != 0 || world->sensorEndEvents[1].count != 0 ||
+		world->contactBeginEvents.count != 0 || world->contactEndEvents[0].count != 0 ||
+		world->contactEndEvents[1].count != 0 || world->contactHitEvents.count != 0 || world->jointEvents.count != 0;
+}
