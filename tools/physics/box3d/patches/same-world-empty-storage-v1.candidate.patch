+b3EmptyTrimResult b3World_TrimEmptyStorage( b3WorldId worldId, bool acknowledgeRetiredEvents )
+{
+	// IsValid must precede access: the asserting unlocked accessor is not a probe.
+	if ( b3World_IsValid( worldId ) == false ) return b3_emptyTrimInvalidWorld;
+	b3World* world = b3GetWorldFromId( worldId );
+	if ( world->locked ) return b3_emptyTrimLocked;
+	if ( world->identity.contactExhausted != 0 ) return b3_emptyTrimFaulted;
+	if ( world->activeTaskCount != 0 || world->userTreeTask != NULL || world->broadPhase.movedSiblings != NULL ||
+		world->splitIslandId != B3_NULL_INDEX ||
+		world->stack.allocation != 0 || world->stack.index != 0 || world->stack.entryCount != 0 ) return b3_emptyTrimBusy;
+	if ( world->recording != NULL ) return b3_emptyTrimRecording;
+	if ( b3GetIdCount( &world->bodyIdPool ) != 0 || b3GetIdCount( &world->shapeIdPool ) != 0 ||
+		b3GetIdCount( &world->jointIdPool ) != 0 || b3GetIdCount( &world->contactIdPool ) != 0 ||
+		b3GetIdCount( &world->islandIdPool ) != 0 || world->sensors.count != 0 || world->compoundShapeCount != 0 )
+		return b3_emptyTrimNonempty;
+	for ( int i = 0; i < b3_identityKindCount; ++i )
+	{
+		uint32_t maximum = i == b3_contactIdentity ? UINT32_MAX : UINT16_MAX;
+		if ( world->identity.high[i] >= maximum ) return b3_emptyTrimIdentityExhausted;
+		if ( world->identity.floor[i] > world->identity.high[i] ) return b3_emptyTrimInconsistent;
+	}
+	if ( world->bodies.count != world->bodyIdPool.nextIndex || world->shapes.count != world->shapeIdPool.nextIndex ||
+		world->contacts.count != world->contactIdPool.nextIndex || world->joints.count != world->jointIdPool.nextIndex ||
+		world->islands.count != world->islandIdPool.nextIndex ||
+		b3GetIdCount( &world->solverSetIdPool ) != b3_firstSleepingSet || world->solverSets.count < b3_firstSleepingSet ||
+		world->solverSets.count != world->solverSetIdPool.nextIndex || world->hullDatabase == NULL ||
+		b3HullMap_size( (b3HullMap*)world->hullDatabase ) != 0 || world->broadPhase.pairSet.count != 0 ||
+		world->workerCount < 1 || world->taskContexts.count != world->workerCount ||
+		world->sensorTaskContexts.count != world->workerCount ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < world->bodies.count; ++i )
+		if ( world->bodies.data[i].id != B3_NULL_INDEX || world->bodies.data[i].generation < world->identity.floor[b3_bodyIdentity] ||
+			world->bodies.data[i].generation > world->identity.high[b3_bodyIdentity] ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < world->shapes.count; ++i )
+		if ( world->shapes.data[i].id != B3_NULL_INDEX || world->shapes.data[i].generation < world->identity.floor[b3_shapeIdentity] ||
+			world->shapes.data[i].generation > world->identity.high[b3_shapeIdentity] ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < world->contacts.count; ++i )
+		if ( world->contacts.data[i].contactId != B3_NULL_INDEX || world->contacts.data[i].generation < world->identity.floor[b3_contactIdentity] ||
+			world->contacts.data[i].generation > world->identity.high[b3_contactIdentity] ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < world->joints.count; ++i )
+		if ( world->joints.data[i].jointId != B3_NULL_INDEX || world->joints.data[i].generation < world->identity.floor[b3_jointIdentity] ||
+			world->joints.data[i].generation > world->identity.high[b3_jointIdentity] ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < world->islands.count; ++i )
+	{
+		b3Island* island = world->islands.data + i;
+		if ( island->islandId != B3_NULL_INDEX || island->bodies.count != 0 || island->contacts.count != 0 ||
+			island->joints.count != 0 ) return b3_emptyTrimInconsistent;
+	}
+	for ( int i = 0; i < world->solverSets.count; ++i )
+	{
+		b3SolverSet* set = world->solverSets.data + i;
+		if ( set->setIndex != ( i < b3_firstSleepingSet ? i : B3_NULL_INDEX ) || set->bodySims.count != 0 ||
+			set->bodyStates.count != 0 || set->jointSims.count != 0 || set->contactIndices.count != 0 ||
+			set->islandSims.count != 0 ) return b3_emptyTrimInconsistent;
+	}
+	for ( int i = 0; i < b3_bodyTypeCount; ++i )
+		if ( world->broadPhase.trees[i].proxyCount != 0 ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < B3_GRAPH_COLOR_COUNT; ++i )
+	{
+		b3GraphColor* color = world->constraintGraph.colors + i;
+		if ( color->jointSims.count != 0 || color->convexContacts.count != 0 || color->contacts.count != 0 )
+			return b3_emptyTrimInconsistent;
+		for ( uint32_t j = 0; j < color->bodySet.blockCount; ++j )
+			if ( color->bodySet.bits[j] != 0 ) return b3_emptyTrimInconsistent;
+	}
+	for ( int i = 0; i < world->manifoldAllocators.count; ++i )
+		if ( world->manifoldAllocators.data[i].allocationCount != 0 ) return b3_emptyTrimInconsistent;
+	for ( int i = 0; i < world->workerCount; ++i )
+		if ( world->taskContexts.data[i].arena.shared == NULL ) return b3_emptyTrimInconsistent;
+	// Joined per-step worker scratch and graph borrowed pointers may be stale: they
+	// are not live entities. Explicit acknowledgement retires all transient views.
+	if ( acknowledgeRetiredEvents == false && b3HasRetainedEvents( world ) ) return b3_emptyTrimUnacknowledgedEvents;
+
+	// All refusal paths precede lock, allocation, event ACK, generation floors and frees.
+	// Allocator failure is explicitly fatal, never a recoverable partial-success return.
+	world->locked = true;
+	b3World replacement = { 0 };
+	replacement.workerCount = world->workerCount;
+	b3CreateEmptyStorage( &replacement, &world->creationCapacity );
+	b3CreateWorkerContexts( &replacement );
+	b3CreateEmptyDebugStorage( &replacement );
+	replacement.stack.maxAllocation = world->stack.maxAllocation;
+	for ( int i = 0; i < world->workerCount; ++i )
+		replacement.taskContexts.data[i].arena.shared->peakDemand = world->taskContexts.data[i].arena.shared->peakDemand;
+
+	// Only container ownership changes. This is NOT memset/replacement of the world.
+	b3World retired = *world;
+	world->stack = replacement.stack;
+	world->broadPhase = replacement.broadPhase;
+	world->constraintGraph = replacement.constraintGraph;
+	world->manifoldAllocators = replacement.manifoldAllocators;
+	world->bodyIdPool = replacement.bodyIdPool;
+	world->bodies = replacement.bodies;
+	world->solverSetIdPool = replacement.solverSetIdPool;
+	world->solverSets = replacement.solverSets;
+	world->jointIdPool = replacement.jointIdPool;
+	world->joints = replacement.joints;
+	world->contactIdPool = replacement.contactIdPool;
+	world->contacts = replacement.contacts;
+	world->islandIdPool = replacement.islandIdPool;
+	world->islands = replacement.islands;
+	world->shapeIdPool = replacement.shapeIdPool;
+	world->shapes = replacement.shapes;
+	world->fatAABBs = replacement.fatAABBs;
+	world->hullDatabase = replacement.hullDatabase;
+	world->names = replacement.names;
+	world->sensors = replacement.sensors;
+	world->taskContexts = replacement.taskContexts;
+	world->sensorTaskContexts = replacement.sensorTaskContexts;
+	world->bodyMoveEvents = replacement.bodyMoveEvents;
+	world->sensorBeginEvents = replacement.sensorBeginEvents;
+	world->contactBeginEvents = replacement.contactBeginEvents;
+	world->sensorEndEvents[0] = replacement.sensorEndEvents[0];
+	world->sensorEndEvents[1] = replacement.sensorEndEvents[1];
+	world->contactEndEvents[0] = replacement.contactEndEvents[0];
+	world->contactEndEvents[1] = replacement.contactEndEvents[1];
+	world->contactHitEvents = replacement.contactHitEvents;
+	world->jointEvents = replacement.jointEvents;
+	world->debugBodySet = replacement.debugBodySet;
+	world->debugJointSet = replacement.debugJointSet;
+	world->debugContactSet = replacement.debugContactSet;
+	world->debugIslandSet = replacement.debugIslandSet;
+	for ( int i = 0; i < b3_identityKindCount; ++i ) world->identity.floor[i] = world->identity.high[i];
+	b3DestroyEmptyStorage( &retired );
+	world->locked = false;
+	return b3_emptyTrimSuccess;
 }
 
