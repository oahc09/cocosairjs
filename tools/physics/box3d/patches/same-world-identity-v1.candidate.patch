+// Pure preflight, before allocation/locking/contact removal. Reject rather than wrap.
+static inline bool b3NextIdentity( const b3World* world, enum b3IdentityKind kind, uint32_t previous,
+								  uint32_t maximum, uint32_t* next )
+{
+	if ( world->identity.contactExhausted != 0 || previous >= maximum ||
+		 world->identity.floor[kind] > previous || previous > world->identity.high[kind] ||
+		 world->identity.high[kind] > maximum )
+	{
+		return false;
+	}
+	*next = previous + UINT32_C( 1 );
+	return true;
+}
+
+// Commit before an identity can escape. No rollback/reset operation is provided.
+static inline void b3CommitIdentity( b3World* world, enum b3IdentityKind kind, uint32_t generation )
+{
+	if ( world->identity.high[kind] < generation )
+	{
+		world->identity.high[kind] = generation;
+	}
+}
