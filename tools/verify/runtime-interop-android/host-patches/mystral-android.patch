+    for (uint64_t i = 0; i < length; ++i) {
+        uint64_t offset;
+        if (!copyUnsigned(g_engine->getPropertyIndex(array, static_cast<uint32_t>(start + i)), 0, false, offset)) return false;
+        offsets.push_back(static_cast<uint32_t>(offset));
+    }
+    return true;
+}
