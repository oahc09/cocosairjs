diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4da566442d68ceda9e5f13a82f63db5cd1f044da..2f3a8db89d17fd313558b224e2cdda55e78c1519 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -84,6 +84,38 @@ message(STATUS "WebGPU: Dawn=${MYSTRAL_USE_DAWN} wgpu=${MYSTRAL_USE_WGPU}")
 set(THIRD_PARTY_DIR ${CMAKE_CURRENT_SOURCE_DIR}/third_party)
 set(MYSTRAL_ANDROID_DEPS_ROOT "${THIRD_PARTY_DIR}/android" CACHE PATH
     "Android-only native dependencies, kept separate from desktop libraries")
+if(ANDROID)
+    if(ANDROID_STL STREQUAL "c++_shared")
+        set(MYSTRAL_DEFAULT_V8_LIBRARY_KIND shared)
+    else()
+        set(MYSTRAL_DEFAULT_V8_LIBRARY_KIND static)
+    endif()
+    set(MYSTRAL_V8_LIBRARY_KIND "${MYSTRAL_DEFAULT_V8_LIBRARY_KIND}" CACHE STRING "Android V8 library kind: static or shared")
+    set_property(CACHE MYSTRAL_V8_LIBRARY_KIND PROPERTY STRINGS static shared)
+    if(NOT MYSTRAL_V8_LIBRARY_KIND MATCHES "^(static|shared)$")
+        message(FATAL_ERROR "MYSTRAL_V8_LIBRARY_KIND must be static or shared")
+    endif()
+    if(MYSTRAL_V8_LIBRARY_KIND STREQUAL "static")
+        set(MYSTRAL_DEFAULT_V8_STARTUP_DATA embedded)
+    else()
+        set(MYSTRAL_DEFAULT_V8_STARTUP_DATA external)
+    endif()
+    set(MYSTRAL_V8_STARTUP_DATA "${MYSTRAL_DEFAULT_V8_STARTUP_DATA}" CACHE STRING "Android V8 startup data: embedded or external")
+    set_property(CACHE MYSTRAL_V8_STARTUP_DATA PROPERTY STRINGS embedded external)
+    if(NOT MYSTRAL_V8_STARTUP_DATA MATCHES "^(embedded|external)$")
+        message(FATAL_ERROR "MYSTRAL_V8_STARTUP_DATA must be embedded or external")
+    endif()
+    if(MYSTRAL_USE_V8 AND ANDROID_STL STREQUAL "c++_static" AND MYSTRAL_V8_LIBRARY_KIND STREQUAL "shared")
+        message(FATAL_ERROR "c++_static cannot use shared V8, which requires libc++_shared.so")
+    endif()
+    if(MYSTRAL_V8_STARTUP_DATA STREQUAL "external")
+        set(MYSTRAL_V8_EXTERNAL_STARTUP_DATA ON)
+    else()
+        set(MYSTRAL_V8_EXTERNAL_STARTUP_DATA OFF)
+    endif()
+    add_compile_definitions(MYSTRAL_V8_EXTERNAL_STARTUP_DATA=$<BOOL:${MYSTRAL_V8_EXTERNAL_STARTUP_DATA}>)
+    message(STATUS "Android C++ STL: ${ANDROID_STL}; V8: ${MYSTRAL_V8_LIBRARY_KIND}/${MYSTRAL_V8_STARTUP_DATA}")
+endif()
 
 # SDL3 - Build from source as static library for single-binary distribution
 set(SDL3_DIR ${THIRD_PARTY_DIR}/sdl3)
@@ -492,7 +524,11 @@ if(MYSTRAL_USE_V8)
         # kuoruan/libv8 structure: v8/include/, v8/lib/
         # Library is libv8_monolith.a (macOS/Linux) or v8_monolith.lib (Windows)
         if(ANDROID)
-            set(V8_LIB_NAME "libv8android.so")
+            if(MYSTRAL_V8_LIBRARY_KIND STREQUAL "static")
+                set(V8_LIB_NAME "libv8_monolith.a")
+            else()
+                set(V8_LIB_NAME "libv8android.so")
+            endif()
         elseif(WIN32)
             set(V8_LIB_NAME "v8_monolith.lib")
         else()
@@ -504,6 +540,8 @@ if(MYSTRAL_USE_V8)
             set(V8_LIBRARY ${V8_DIR}/${V8_LIB_NAME})
         elseif(EXISTS ${V8_DIR}/lib/${V8_LIB_NAME})
             set(V8_LIBRARY ${V8_DIR}/lib/${V8_LIB_NAME})
+        elseif(ANDROID)
+            set(V8_LIBRARY "")
         else()
             find_library(V8_LIBRARY
                 NAMES v8_monolith
@@ -524,7 +562,7 @@ if(MYSTRAL_USE_V8)
         endif()
 
         if(V8_LIBRARY AND V8_INCLUDE_DIR)
-            if(ANDROID)
+            if(ANDROID AND MYSTRAL_V8_LIBRARY_KIND STREQUAL "shared")
                 add_library(v8::v8 SHARED IMPORTED)
             else()
                 add_library(v8::v8 STATIC IMPORTED)
@@ -567,7 +605,7 @@ endif()
 
 # JavaScriptCore (macOS/iOS)
 if(ANDROID AND MYSTRAL_USE_V8 AND NOT TARGET v8::v8)
-    message(FATAL_ERROR "Android V8 requires matching headers and ${ANDROID_ABI}/libv8android.so")
+    message(FATAL_ERROR "Android V8 requires matching headers and ${ANDROID_ABI}/${V8_LIB_NAME}")
 endif()
 if(MYSTRAL_USE_JSC)
     if(APPLE)
@@ -1244,6 +1282,10 @@ if(MYSTRAL_USE_V8 AND TARGET v8::v8)
     endif()
 endif()
 
+if(ANDROID AND ANDROID_STL STREQUAL "c++_static")
+    target_link_options(mystral-runtime PRIVATE "-Wl,-Map,${CMAKE_CURRENT_BINARY_DIR}/mystral-runtime.map,--cref")
+endif()
+
 # SDL3 linkage - prefer static target for single-binary distribution
 if(SDL3_STATIC_TARGET)
     target_link_libraries(mystral-runtime PRIVATE ${SDL3_STATIC_TARGET})
diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index 6906f3789410d32315579a85f395df4a7c5218e5..a60a01f5d3584fc77c2158692b758246723061cc 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -6,6 +6,19 @@ val jsEngine = providers.gradleProperty("mystralJsEngine").orElse("quickjs").get
 val gpuBackend = providers.gradleProperty("mystralGpuBackend").orElse("wgpu").get()
 require(jsEngine in setOf("quickjs", "v8")) { "mystralJsEngine must be quickjs or v8" }
 require(gpuBackend in setOf("wgpu", "dawn")) { "mystralGpuBackend must be wgpu or dawn" }
+val androidStl = providers.gradleProperty("mystralAndroidStl").orElse("c++_static").get()
+require(androidStl in setOf("c++_static", "c++_shared")) { "mystralAndroidStl must be c++_static or c++_shared" }
+val v8LibraryKind = providers.gradleProperty("mystralV8LibraryKind")
+    .orElse(if (androidStl == "c++_static") "static" else "shared").get()
+val v8StartupData = providers.gradleProperty("mystralV8StartupData")
+    .orElse(if (v8LibraryKind == "static") "embedded" else "external").get()
+require(v8LibraryKind in setOf("static", "shared")) { "mystralV8LibraryKind must be static or shared" }
+require(v8StartupData in setOf("embedded", "external")) { "mystralV8StartupData must be embedded or external" }
+require(jsEngine != "v8" || androidStl != "c++_static" || v8LibraryKind == "static") {
+    "c++_static requires a matching static V8; the shared V8 depends on libc++_shared.so"
+}
+val sdlVersion = providers.gradleProperty("mystralSdlVersion").orElse("3.2.30").get()
+require(sdlVersion in setOf("3.2.8", "3.2.30")) { "mystralSdlVersion must be 3.2.8 or 3.2.30" }
 val interopAbis = providers.gradleProperty("interopAbis").orElse("arm64-v8a,x86_64").get()
     .split(',').map { it.trim() }.filter { it.isNotEmpty() }
 require(interopAbis.isNotEmpty() && interopAbis.all { it in setOf("arm64-v8a", "x86_64") })
@@ -13,9 +26,14 @@ val androidDeps = rootProject.file(
     providers.gradleProperty("mystralAndroidDeps").orElse("../third_party/android").get()
 )
 val stagedSnapshots = layout.buildDirectory.dir("generated/interopSnapshots")
+val clearEmbeddedV8Snapshots = tasks.register<Delete>("clearEmbeddedV8Snapshots") {
+    onlyIf { jsEngine != "v8" || v8StartupData == "embedded" }
+    delete(stagedSnapshots)
+}
 val stageV8Snapshots = tasks.register<Sync>("stageV8Snapshots") {
+    dependsOn(clearEmbeddedV8Snapshots)
     into(stagedSnapshots)
-    if (jsEngine == "v8") {
+    if (jsEngine == "v8" && v8StartupData == "external") {
         for (abi in interopAbis) {
             from(androidDeps.resolve("v8/$abi")) {
                 include("snapshot_blob.bin")
@@ -55,7 +73,9 @@ android {
                 // CMake arguments for the Mystral native build
                 arguments.addAll(listOf(
                     "-DANDROID=ON",
-                    "-DANDROID_STL=c++_shared",
+                    "-DANDROID_STL=$androidStl",
+                    "-DMYSTRAL_V8_LIBRARY_KIND=$v8LibraryKind",
+                    "-DMYSTRAL_V8_STARTUP_DATA=$v8StartupData",
                     "-DMYSTRAL_ANDROID_DEPS_ROOT=${androidDeps.invariantSeparatorsPath}",
                     "-DMYSTRAL_USE_QUICKJS=${if (jsEngine == "quickjs") "ON" else "OFF"}",
                     "-DMYSTRAL_USE_V8=${if (jsEngine == "v8") "ON" else "OFF"}",
@@ -121,5 +141,5 @@ tasks.named("preBuild").configure { dependsOn(stageV8Snapshots) }
 
 dependencies {
     // SDL3 AAR for Java bindings (SDLActivity, etc.)
-    implementation(files(androidDeps.resolve("sdl3/SDL3-3.2.8.aar")))
+    implementation(files(androidDeps.resolve("sdl3/SDL3-$sdlVersion.aar")))
 }
