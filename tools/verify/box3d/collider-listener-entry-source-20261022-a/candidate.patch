+// Eventify mixes in this runtime-only internal entry without declaring it in IEventified.
+// Fence it locally without broadening Collider's declared API or changing its legacy cache behavior.
+const colliderClear = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(Collider.prototype), 'clear')!;
+Object.defineProperty(Collider.prototype, 'clear', {
+    ...colliderClear,
+    value (this: Collider): void {
+        assertMutationAllowed(this, 'Collider.clear');
+        colliderClear.value.call(this);
+    },
+});
