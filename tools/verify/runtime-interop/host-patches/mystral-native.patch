+    const char* name = type == WGPUErrorType_Validation ? "GPUValidationError" :
+        type == WGPUErrorType_OutOfMemory ? "GPUOutOfMemoryError" : "GPUInternalError";
+    g_engine->setProperty(error, "name", g_engine->newString(name));
+    return error;
