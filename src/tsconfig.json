{
  "compilerOptions": {
    "target": "es6",
    "lib": ["es2015", "es2017", "dom"],
    "module": "commonjs",
    // Runtime imports are bundled by Rollup, not executed as Node CommonJS.
    // Match the root typecheck resolver instead of ccbuild's NodeNext fallback.
    "moduleResolution": "node",
    "sourceMap": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": false,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // V1.2 P1（Air 修改）：ccbuild 的 dtsBundler 不带 rootDir 调 tsc，中间产物目录
    // 按「全部输入文件的最长公共根」布局。V1.2 把 @cocos/box2d 等运行库 vendored 到
    // src/node_modules/ 后，其 types 回指仓库根 node_modules（box2d 声明闭包 92 MB，
    // 不进仓库），于是公共根上移到仓库根，emit 结果落到 __dts_before_bundle/src/**，
    // 而 ccbuild 生成的 virtual-cc.d.ts 仍按 __dts_before_bundle/exports/** 引用 →
    // 解析全空，产出的 cc.d.ts 退化成 `declare module "cc" { export {}; }`。
    // 显式钉住 rootDir，声明布局恒以引擎根为准。
    "rootDir": "./",

    "baseUrl": "./",
    "paths": {
        "cc.decorator": [
            "cocos/core/data/decorators/index.ts"
        ],
        "@cocos/engine/*": [
            "*"
        ]
    },
    "types": [
      "./@types/globals",
      "./@types/consts",
      "./@types/jsb",
      "./@types/editor-extends",
      "./@types/webGL.extras",
      "./@types/webGL2.extras",
      "./@types/webGPU",
      "./@types/box2d",
      "./@types/emscripten-assets",
      "./@types/external-modules",

      // pal
      "./@types/pal/system-info",
      "./@types/pal/screen-adapter",
      "./@types/pal/minigame",
      "./@types/pal/audio",
      "./@types/pal/input",
      "./@types/pal/env",
      "./@types/pal/pacer",
      "./@types/pal/wasm"
    ]
  },
  "include": [
      "exports/**/*.ts",
      "predefine.ts",
      "cocos/**/*.ts",
      "pal/**/*.ts",
      "external/**/*.ts"
  ],
  "exclude": [
      "editor",
      // Same upstream empty-script exemption as the root typecheck.
      "cocos/physics/cannon/constraints/cannon-distance-constraint.ts",

      // WG-01: active TypeScript WebGPU code participates in declarations.
      // Dormant native-device WASM bridge files remain outside this graph.
      "cocos/gfx/webgpu/override.ts",
      "cocos/gfx/webgpu/webgpu-define.ts",
      "cocos/webgpu/**",


      // V1.2 批次 D-4 / G-3（LV12-14 / LV12-16，与 Deviation-04 同一类，登记为 UPSTREAM.md Deviation-05）：
      // 这三个 wasm 后端子图已按上游原文抽取并逐字节核对（82 文件），但它们的类型只存在于
      // `native/external/emscripten/{bullet/bullet,physx/physx,box2d/box2d}.d.ts` —— 该目录不在本引擎快照内
      // （上游 tsconfig.json 的 types[] 正指着它），故在仓库内**无法**完成类型核对；实测纳入时
      // typecheck 从 0 红到 118（`Cannot find namespace 'Bullet'/'PhysX'`、`Namespace 'B2' has no exported member …`、
      // `Cannot find module 'external:emscripten/{bullet,physx}/…'`）。与 gfx-webgpu 同因同治：整图移出核对与声明闭包，
      // 默认 feature 集不引用它们 ⇒ 三产物逐字节不变。
      "cocos/physics/bullet/**",
      "cocos/physics/physx/**",
      "cocos/physics-2d/box2d-wasm/**",
      "exports/physics-ammo.ts",
      "exports/physics-physx.ts",
      "exports/physics-2d-box2d-wasm.ts"
  ]
}
