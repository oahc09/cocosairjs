    }
  ],
  "routing_records": [
    {
      "name": "cocosair",
      "description": "Route AIR tasks by subsystem or visual symptom; choose direct dependencies and check capabilities.",
      "owns": [
        "skill-routing",
        "primary-owner",
        "direct-dependencies",
        "code-first",
        "capability-layers"
      ],
      "when_to_use": [
        "which skill owns this AIR task",
        "choose only the dependencies needed for this step",
        "adapt Creator knowledge to code-first AIR",
        "distinguish source exports from proven browser capabilities"
      ],
      "not_for": [
        "startup errors -> cocosair-application",
        "material property failures -> cocosair-materials-effects"
      ],
      "metadata": {
        "description_zh": "为 Cocos AIR 任务选择主技能和直接依赖，并遵循原生 API、启动时序与能力证据分层。用于开始 AIR 开发、定位能力归属或选择技能。"
      }
    },
    {
      "name": "cocosair-2d-subsystems",
      "description": "Build DragonBones, TiledMap, 2D/3D particles and billboards from runtime data. Use for raw asset strings, missing pixels, MotionStreak or Spine backend limits.",
      "owns": [
        "dragonbones",
        "tiledmap",
        "particle-2d",
        "billboard",
        "motion-streak",
        "spine-limits"
      ],
      "when_to_use": [
        "build DragonBones assets from raw JSON strings",
        "TiledMap edits do not redraw or resolve objects",
        "particles compute but render no pixels; createAirParticleSystem 3D emitters/trails CPU/GPU",
        "Spine skeleton stays blank without an error",
        "billboard or motion trail is invisible"
      ],
      "not_for": [
        "basic UI layout and controls -> cocosair-ui-2d",
        "3D skeleton deformation -> cocosair-skinning-morph",
        "remote asset caching -> cocosair-assets"
      ],
      "metadata": {
        "description_zh": "配置 Spine、DragonBones、TiledMap、二维粒子和 Billboard 的原生运行时契约。用于资源构造、空白画面或子系统能力边界问题。"
      }
    },
    {
      "name": "cocosair-agent-session",
      "description": "Inspect live scenes and frames with devtools; read runtime diagnostics. Use for scoped session writes, pixel probes or duplicate requestId INVALID_ARGUMENT errors.",
      "owns": [
        "agent-session",
        "scene-inspection",
        "scoped-writes",
        "frame-capture",
        "pixel-probes",
        "runtime-diagnostics"
      ],
      "when_to_use": [
        "inspect the running scene or node",
        "apply a scoped change through an agent session",
        "capture a frame after drawing",
        "read runtime errors and diagnostics",
        "duplicate requestId is rejected"
      ],
      "not_for": [
        "app startup or shutdown -> cocosair-application",
        "verification gates and release evidence -> cocosair-verification",
        "scene-tree implementation -> cocosair-scene-graph"
      ],
      "metadata": {
        "description_zh": "使用开发工具观察运行时、按明确范围写入、捕获画面和读取诊断。用于实时应用检查或受控自动化，工具不属于默认运行时包。"
      }
    },
    {
      "name": "cocosair-animation-tween",
      "description": "Animate tweens and AnimationClip tracks with one step clock. Use to loop a sequence on a target, reverseTime, clean up playback or diagnose unavailable pose graphs.",
      "owns": [
        "tween",
        "animation-clip",
        "track-path",
        "wrap-mode",
        "step-clock",
        "pose-graph-limits"
      ],
      "when_to_use": [
        "move or rotate a node over time",
        "a clip plays once instead of looping",
        "a tween will not reverse",
        "track classes fail to import by name",
        "step deterministic frames without a second live clock"
      ],
      "not_for": [
        "glTF loading and instance setup -> cocosair-gltf",
        "skeletal binding and morph weights -> cocosair-skinning-morph",
        "scalar easing calculations -> cocosair-math"
      ],
      "metadata": {
        "description_zh": "使用 AnimationClip、Animation 和 tween，管理播放模式、组合及单一时钟。用于动画播放、补间回收或确定性步进问题。"
      }
    },
    {
      "name": "cocosair-application",
      "description": "Configure createAirApp options, canvas, lifecycle, screen sizing and context health. Use for WEBGL2_REQUIRED startup errors, scene replacement, session cleanup or lost contexts.",
      "owns": [
        "startup-admission",
        "app-lifecycle",
        "screen-sizing",
        "context-health",
        "session-cleanup"
      ],
      "when_to_use": [
        "createAirApp rejects options or fails startup",
        "replace or release the running scene",
        "app closed and will not restart",
        "fit a container or set design resolution",
        "lost context or scene cleanup stalls"
      ],
      "not_for": [
        "package imports or page shell -> cocosair-project-setup",
        "persistent SceneStack pages -> cocosair-input-action",
        "live-session inspection -> cocosair-agent-session"
      ],
      "metadata": {
        "description_zh": "配置 createAirApp 和应用生命周期、屏幕尺寸、会话清理及 WebGL 上下文健康。用于启动错误、场景替换、关闭和自定义 canvas。"
      }
    },
    {
      "name": "cocosair-assets",
      "description": "Load asset URL textures, atlases and BMFont with AssetBank. Use for refcounted disposal, extension selection, cache reuse or AIR_E_ATLAS_IN_USE/AIR_E_FNT_IN_USE cleanup.",
      "owns": [
        "asset-bank",
        "asset-cache",
        "reference-counting",
        "texture2d",
        "atlas",
        "bmfont"
      ],
      "when_to_use": [
