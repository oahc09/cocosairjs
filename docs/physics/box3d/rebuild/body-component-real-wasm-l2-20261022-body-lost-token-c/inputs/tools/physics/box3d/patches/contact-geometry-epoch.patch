+bool b3Contact_GetGeometryBasis( b3ContactId contactId, b3ContactGeometryBasis* outBasis )
+{
+	if ( outBasis == NULL || b3Contact_IsValid( contactId ) == false )
+	{
+		return false;
+	}
+	b3World* world = b3GetWorld( contactId.world0 );
+	if ( world->locked )
+	{
+		return false;
+	}
+	b3Contact* contact = b3GetContactFullId( world, contactId );
+	if ( contact->geometryValid == false || contact->manifoldCount == 0 ||
+		 ( contact->flags & b3_relativeTransformValid ) == 0 )
+	{
+		return false;
+	}
+	*outBasis = contact->geometryBasis;
+	return true;
+}
