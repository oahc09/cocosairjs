      "void b3Body_SetType( b3BodyId bodyId, b3BodyType type )",
      "{",
      "\tb3World* world = b3GetUnlockedWorld( bodyId.world0 );",
      "\tif ( world == NULL )",
      "\t{",
      "\t\treturn;",
      "\t}",
      "",
      "\tB3_REC( world, BodySetType, bodyId, (int32_t)type );",
      "",
      "\tworld->locked = true;",
      "\tb3Body* body = b3GetBodyFullId( world, bodyId );",
      "",
      "\tb3BodyType originalType = body->type;",
      "\tif ( originalType == type )",
      "\t{",
      "\t\tworld->locked = false;",
      "\t\treturn;",
      "\t}",
      "",
      "\tif ( type != b3_staticBody )",
      "\t{",
      "\t\tint shapeId = body->headShapeId;",
      "\t\twhile ( shapeId != B3_NULL_INDEX )",
      "\t\t{",
      "\t\t\tb3Shape* shape = b3Array_Get( world->shapes, shapeId );",
      "\t\t\tif ( shape->type == b3_compoundShape || shape->type == b3_heightShape )",
      "\t\t\t{",
      "\t\t\t\t// Setting the body type is not supported for bodies with compound shapes",
      "\t\t\t\treturn;",
      "\t\t\t}",
      "",
      "\t\t\tshapeId = shape->nextShapeId;",
      "\t\t}",
      "\t}",
      "",
      "\t// Stage 1: skip disabled bodies",
      "\tif ( body->setIndex == b3_disabledSet )",
      "\t{",
      "\t\t// Disabled bodies don't change solver sets or islands when they change type."
    ]
  },
  "finding": "world locked before compound/height early return; bridge guards unsupported type transitions, no original source patch"
