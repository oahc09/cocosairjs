diff --git a/include/mystral/platform/android_surface.h b/include/mystral/platform/android_surface.h
new file mode 100644
index 0000000000000000000000000000000000000000..713aed88ce4a8b7c0e2cb850dd7f9c34573b877e
--- /dev/null
+++ b/include/mystral/platform/android_surface.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#if defined(__ANDROID__)
+#include <android/native_window.h>
+#include <cstdint>
+
+namespace mystral {
+namespace platform {
+
+// Java publishes only real Surface callbacks. Each snapshot owns a window reference;
+// the SDL/JavaScript owner releases it after use. No GPU work runs on the UI thread.
+struct AndroidSurfaceState {
+    ANativeWindow* window = nullptr;
+    int generation = 0;
+    uint64_t revision = 0;
+};
+
+AndroidSurfaceState acquireAndroidSurfaceState();
+void clearAndroidSurfaceState();
+
+} // namespace platform
+} // namespace mystral
+#endif
